# ============================================================
# MineUAV-Learning project-specific exclusions
# ============================================================

# Local backup
README_old_backup.md

# Third-party repositories: do not vendor nested git repos
third_party/

# Large raw experiment traces
mujoco/reports/**/integral_traces/
mujoco/reports/ppo_braking_policy_steps.csv.gz

# Raw CAD assembly - keep reports/scripts/previews instead
cad_check/assembly_raw.stl

# Python cache anywhere
**/__pycache__/
*.pyc

# ============================================================
# Raw RL training logs
# ============================================================
mujoco/rl/logs/

# Raw viewer captures
*.xwd

# Raw closed-loop diagnostic CSVs
mujoco/reports/closed_loop_*.csv

# Detailed per-condition report fragments
mujoco/reports/*_parts/

# Old / intermediate large RL experiment reports
mujoco/reports/ppo_waypoint_v2_lowstd_multiseed/seed_*.json
mujoco/reports/ppo_waypoint_curriculum.json
mujoco/reports/ppo_waypoint_reward_v4.json
mujoco/reports/ppo_v2_exploration_audit_raw_mean.json

# Keep source/report summaries, exclude raw trajectory-type data
mujoco/reports/**/*_trace.json
mujoco/reports/**/*_traces.json
docs/superpowers/
.superpowers/

# Raw datasets/derived latent arrays already covered by *.npz and *.npy above.
# Keep manifest/config/hash metadata, not transient logs or replay checkpoints.
*.log
mujoco/reports/*_progress.json
mujoco/reports/*_pre*/
mujoco/rl/models/ppo_recurrent_*/

# Small representative supervised models are explicitly versioned.
mujoco/rl/models/*.pt
!mujoco/rl/models/markov_dynamics_mlp.pt
!mujoco/rl/models/history_latent_gru.pt
!mujoco/rl/models/history_latent_gru_no_memory.pt
!mujoco/rl/models/oracle_dynamics_mlp.pt
!mujoco/rl/models/latent_pi_linear_probe.pt
